#!/usr/bin/env bash
# Local pre-push hook: runs the same fast checks the pull-request CI job runs,
# so a break shows up here instead of on GitHub.
# Install once per clone with: bash .githooks/install.sh
# Bypass in an emergency with: git push --no-verify
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# If every local sha is all zeros the push only deletes branches, so skip the checks.
zero="0000000000000000000000000000000000000000"
all_deletes=1
seen=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  seen=1
  if [ -n "${local_sha//0/}" ]; then
    all_deletes=0
  fi
done
if [ "$seen" = 1 ] && [ "$all_deletes" = 1 ]; then
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "pre-push: node_modules is missing. Run: npm ci" >&2
  exit 1
fi

start=$(date +%s)
echo "pre-push: typecheck, npm test"

echo "+ npm run typecheck"
npm run typecheck
echo "+ npm test"
npm test

echo "pre-push: all checks passed in $(( $(date +%s) - start ))s"
