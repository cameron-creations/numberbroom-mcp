{
  "name": "numberbroom-mcp",
  "version": "1.1.0",
  "description": "Remote MCP server for the NumberBroom phone verification API: lets AI agents check phone line type, carrier, and TCPA litigator status.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/server": "2.2.0",
    "agents": "0.22.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.4",
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.7.0",
    "vitest": "4.1.11",
    "wrangler": "^4.137.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "proxy-addr": "2.0.8",
    "fast-uri": "3.1.8",
    "ip-address": "10.7.1",
    "source-map-js": "1.2.2",
    "undici": "7.29.1",
    "sharp": "0.35.5"
  }
