  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.2.4",
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.7.0",
    "vitest": "4.1.12",
    "wrangler": "^4.151.3"
  },
  "overrides": {
    "proxy-addr": "2.0.8",
    "fast-uri": "3.1.9",
    "ip-address": "10.7.4",
    "source-map-js": "1.2.2",
    "undici": "7.30.1",
    "sharp": "0.35.5",
    "body-parser": "2.4.0",
    "hono": "4.13.11",
    "@hono/node-server": "2.1.3",
    "qs": "6.16.1",
